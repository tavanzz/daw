# Writes the header with the commit the build comes from (see services/CMakeLists.txt):
#
#   cmake -DSOURCE_DIR=<repository> -DOUTPUT=<header> -P cmake/BuildCommit.cmake
#
# The commit's own date stands for the build's, so two builds of one commit agree.

set(commit "unknown")
set(date "")
set(modified "false")

find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse --short=12 HEAD
        OUTPUT_VARIABLE git_commit RESULT_VARIABLE git_result
        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(git_result EQUAL 0 AND git_commit)
        set(commit "${git_commit}")
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" log -1 --format=%cI
            OUTPUT_VARIABLE date OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        execute_process(
            COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" status --porcelain --untracked-files=no
            OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(changes)
            set(modified "true")
        endif()
    endif()
endif()

set(content "#pragma once
// Generated by cmake/BuildCommit.cmake at build time. Do not edit.
#define DAW_BUILD_COMMIT \"${commit}\"
#define DAW_BUILD_COMMIT_DATE \"${date}\"
#define DAW_BUILD_COMMIT_MODIFIED ${modified}
")

set(existing "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" existing)
endif()
if(NOT existing STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
