@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .

<@uri@>
    a lv2:Plugin , lv2:UtilityPlugin ;
    doap:name "@name@" ;
    doap:maintainer [ foaf:name "DAW Tests" ] ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in_left" ;
        lv2:name "In Left"
    ] , [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 1 ;
        lv2:symbol "in_right" ;
        lv2:name "In Right"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 2 ;
        lv2:symbol "out_left" ;
        lv2:name "Out Left"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 3 ;
        lv2:symbol "out_right" ;
        lv2:name "Out Right"
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "@parameter@" ;
        lv2:name "@parameterName@" ;
        lv2:default @default@ ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 5 ;
        lv2:symbol "latency" ;
        lv2:name "Latency" ;
        lv2:designation lv2:latency ;
        lv2:portProperty lv2:reportsLatency , lv2:integer ;
        lv2:minimum 0 ;
        lv2:maximum 100000
    ] .
